{
  "name": "ilm-naafi-worker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:apply": "wrangler d1 execute ilm-naafi-db --remote --file=./migrations/0001_init.sql",
    "db:apply:local": "wrangler d1 execute ilm-naafi-db --local --file=./migrations/0001_init.sql"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.0.3",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "typescript": "^5.7.2",
    "wrangler": "^4.151.1"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261012.1": true,
    "sharp@0.35.5": true
  }
}
